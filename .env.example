# Frontend environment — normally written automatically by `npx convex dev`
# Copy this file to .env.local only if you need to set them by hand.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex backend URL for the frontend client
VITE_CONVEX_URL=

# NOTE: backend env vars (SITE_URL, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, ...)
# are set with `npx convex env set <NAME> <value>` — see README.md.
